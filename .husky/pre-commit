#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Only lint changed files (staged for commit)
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$CHANGED_FILES" ]; then
  echo "🔍 Linting staged files..."
  npx eslint --cache --fix --max-warnings 0 $CHANGED_FILES || exit 1
fi

# Type-check (non-blocking warning)
echo "📋 Type checking..."
npm run type-check || true
